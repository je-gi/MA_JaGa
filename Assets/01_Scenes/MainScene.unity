  m_text: "using UnityEngine;\L\Lpublic class MotorStart : MonoBehaviour\L{\L   
    public float kraftstoffmenge;\L    public float temperatur;\L    public float
    drehzahl;\L    public float leistung;\L\L    void Start()\L    {\L        kraftstoffmenge
    = 50.0f; \n\L        temperatur = 95.0f; \L\L        if (kraftstoffmenge > 0)\L       
    {\L            Debug.Log(\"Motor kann gestartet werden!\");\L\L            if
    (temperatur < 100)\L            {\L                Debug.Log(\"Motor l\xE4uft!\");\L\L               
    leistung = kraftstoffmenge             *              drehzahl           ;\L               
    Debug.Log(\"Motorleistung: \" + leistung);\L            }\L            else\L           
    {\L                Debug.Log(\"Motor \xFCberhitzt!\");\L            }\L       
    }\L    }\L}"
