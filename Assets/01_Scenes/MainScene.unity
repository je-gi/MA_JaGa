  m_text: "using UnityEngine;\L\Lpublic class MotorStart : MonoBehaviour\L{\L   
    public float kraftstoffmenge;\L    public float temperatur;\L    public float
    drehzahl;\L    public float leistung;\L\L    void Start()\L    {\L        kraftstoffmenge
    = 50.0f; \L\L        temperatur = 95.0f;  \L\L        if (kraftstoffmenge > 0)\L       
    {\L            if (temperatur < 100)\L            {\L                Debug.Log(\"Motor
    l\xE4uft!\");\L\L                leistung = kraftstoffmenge * drehzahl;\L               
    Debug.Log(\"Motorleistung: \" + leistung);\L\L                // Turbo-Modus
    aktivieren\L                Turbo();\L            }\L            else\L           
    {\L                Debug.Log(\"Motor \xFCberhitzt!\");\L            }\L       
    }\L    }\L\L    void Turbo()\L    {\L        // Verdopple die Motorleistung f\xFCr
    den Turbo-Modus\L        leistung = leistung                 *              2             
    ;\L        Debug.Log(\"Motorleistung mit Turbo: \" + leistung);\L    }\n}"
